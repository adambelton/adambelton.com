{
  "name": "@adambelton/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "syndicate:dev-to": "node --import tsx src/website/content/syndication/dev-to-syndication.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build --ssr src/website/prerender/prerender.tsx --outDir .prerender --emptyOutDir && node .prerender/prerender.js"
  },
  "dependencies": {
    "@adambelton/auth": "workspace:*",
    "@adambelton/products": "workspace:*",
    "@adambelton/shared": "workspace:*",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "better-auth": "^1.6.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.15.34",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "unified": "^11.0.5",
    "vite": "^7.0.6",
    "yaml": "^2.9.0"
  }
}
