generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationMessageRole {
  user
  assistant
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  isOwner       Boolean  @default(false) @map("is_owner")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  accounts                   Account[]
  sessions                   Session[]
  socraticDraftConversations SocraticDraftConversation[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

model SocraticDraftConversation {
  id                  String   @id
  userId              String   @map("user_id")
  nextMessagePosition Int      @default(0) @map("next_message_position")
  ideaMapRevision     Int      @default(0) @map("idea_map_revision")
  draftFormat         String?  @map("draft_format")
  draftFormatRevision Int      @default(0) @map("draft_format_revision")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user     User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SocraticDraftConversationMessage[]
  ideaMapRevisions SocraticDraftIdeaMapRevision[]
  draft SocraticDraftDraft?
  operations SocraticDraftOperation[]

  @@index([userId, updatedAt])
  @@unique([id, userId])
  @@map("socratic_draft_conversations")
}

model SocraticDraftIdeaMapRevision {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  revision       Int
  ideas          Json
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation SocraticDraftConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, revision])
  @@index([conversationId])
  @@map("socratic_draft_idea_map_revisions")
}

model SocraticDraftConversationMessage {
  id             String                  @id @default(uuid())
  conversationId String                  @map("conversation_id")
  role           ConversationMessageRole
  content        String
  position       Int
  createdAt      DateTime                @default(now()) @map("created_at")

  conversation SocraticDraftConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, position])
  @@index([conversationId])
  @@map("socratic_draft_conversation_messages")
}

model SocraticDraftDraft {
  id              String   @id
  conversationId  String   @unique @map("conversation_id")
  body            String
  contentFormat   String   @default("plain_text") @map("content_format")
  schemaVersion   Int?     @map("schema_version")
  currentRevision Int      @default(1) @map("current_revision")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  conversation SocraticDraftConversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  revisions    SocraticDraftDraftRevision[]
  proposals    SocraticDraftRevisionProposal[]

  @@map("socratic_draft_drafts")
}

model SocraticDraftDraftRevision {
  id                   String   @id @default(uuid())
  draftId              String   @map("draft_id")
  revision             Int
  body                 String
  contentFormat        String   @default("plain_text") @map("content_format")
  schemaVersion        Int?     @map("schema_version")
  source               String
  proposalId           String?  @map("proposal_id")
  restoredFromRevision Int?     @map("restored_from_revision")
  createdAt            DateTime @default(now()) @map("created_at")

  draft SocraticDraftDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, revision])
  @@index([draftId])
  @@map("socratic_draft_draft_revisions")
}

model SocraticDraftRevisionProposal {
  id                      String   @id
  draftId                 String   @map("draft_id")
  baseDraftRevision       Int      @map("base_draft_revision")
  scope                   String
  originalStart           Int      @map("original_start")
  originalEnd             Int      @map("original_end")
  originalContent         String   @map("original_content")
  userInstruction         String   @map("user_instruction")
  state                   String
  currentProposalRevision Int      @default(1) @map("current_proposal_revision")
  createdAt               DateTime @default(now()) @map("created_at")
  resolvedAt              DateTime? @map("resolved_at")

  draft    SocraticDraftDraft                    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  versions SocraticDraftRevisionProposalVersion[]

  @@index([draftId, state])
  @@map("socratic_draft_revision_proposals")
}

model SocraticDraftRevisionProposalVersion {
  id              String   @id @default(uuid())
  proposalId      String   @map("proposal_id")
  revision        Int
  proposedContent String   @map("proposed_content")
  intendedEffect  String   @map("intended_effect")
  createdAt       DateTime @default(now()) @map("created_at")

  proposal SocraticDraftRevisionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, revision])
  @@index([proposalId])
  @@map("socratic_draft_revision_proposal_versions")
}

model SocraticDraftOperation {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  operationId    String   @map("operation_id")
  kind           String
  createdAt      DateTime @default(now()) @map("created_at")

  conversation SocraticDraftConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, operationId])
  @@index([conversationId])
  @@map("socratic_draft_operations")
}
