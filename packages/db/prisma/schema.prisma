generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationMessageRole {
  user
  assistant
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  isOwner       Boolean  @default(false) @map("is_owner")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  accounts                   Account[]
  sessions                   Session[]
  socraticDraftConversations SocraticDraftConversation[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

model SocraticDraftConversation {
  id                  String   @id
  userId              String   @map("user_id")
  nextMessagePosition Int      @default(0) @map("next_message_position")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user     User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SocraticDraftConversationMessage[]

  @@index([userId, updatedAt])
  @@unique([id, userId])
  @@map("socratic_draft_conversations")
}

model SocraticDraftConversationMessage {
  id             String                  @id @default(uuid())
  conversationId String                  @map("conversation_id")
  role           ConversationMessageRole
  content        String
  position       Int
  createdAt      DateTime                @default(now()) @map("created_at")

  conversation SocraticDraftConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, position])
  @@index([conversationId])
  @@map("socratic_draft_conversation_messages")
}
