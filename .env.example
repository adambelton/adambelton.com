# Local API server
PORT=8787

# Neon Postgres / Prisma
# Keep real connection strings in .env.local. Do not commit secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
NEON_BRANCH="dev"

# Auth
# Keep real secrets in .env.local or host environment only.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
OWNER_EMAIL="hello@adambelton.com"

# Transactional email
RESEND_API_KEY="replace-with-resend-api-key"
AUTH_EMAIL_FROM="Adam Belton <hello@adambelton.com>"

# Hosted AI
# Calls fail closed unless this value is exactly "true", AI_PROVIDER names a
# supported provider, and that provider's API key is configured.
HOSTED_AI_ENABLED="false"
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_EFFORT="medium"

# Required in production. Non-production defaults use these approved values.
THOUGHTFORM_PERSONAL_DAILY_OPERATION_LIMIT="120"
THOUGHTFORM_PERSONAL_DAILY_TOKEN_LIMIT="600000"
THOUGHTFORM_GLOBAL_DAILY_OPERATION_LIMIT="600"
THOUGHTFORM_GLOBAL_DAILY_TOKEN_LIMIT="3000000"

# Retained alternative provider configuration.
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_MODEL="gpt-5.6-terra"

# Prompt management plus owner-only evaluation tracing. All three values are
# required. Temporary demo operations are never traced.
LANGFUSE_PUBLIC_KEY="replace-with-langfuse-public-key"
LANGFUSE_SECRET_KEY="replace-with-langfuse-secret-key"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
LANGFUSE_TRACING_ENVIRONMENT="development"
