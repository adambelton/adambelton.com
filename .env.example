# Local API server
PORT=8787

# Neon Postgres / Prisma
# Keep real connection strings in .env.local. Do not commit secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
NEON_BRANCH="dev"

# Auth
# Keep real secrets in .env.local or host environment only.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
OWNER_EMAIL="hello@adambelton.com"

# Transactional email
RESEND_API_KEY="replace-with-resend-api-key"
AUTH_EMAIL_FROM="Adam Belton <hello@adambelton.com>"

# OpenAI
# Hosted model calls fail closed unless this value is exactly "true" and an API
# key is configured. Set it to "false" as the emergency kill switch.
HOSTED_AI_ENABLED="false"
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_MODEL="gpt-5-mini"
