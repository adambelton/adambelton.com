# Local API server
PORT=8787

# Neon Postgres / Prisma
# Keep real connection strings in .env.local. Do not commit secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
NEON_BRANCH="dev"

# Auth
# Keep real secrets in .env.local or host environment only.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
OWNER_EMAIL="hello@adambelton.com"

# Transactional email
RESEND_API_KEY="replace-with-resend-api-key"
AUTH_EMAIL_FROM="Adam Belton <hello@adambelton.com>"

# Hosted AI
# Calls fail closed unless this value is exactly "true", AI_PROVIDER names a
# supported provider, and that provider's API key is configured.
HOSTED_AI_ENABLED="false"
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="replace-with-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-5"

# Retained alternative provider configuration.
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_MODEL="gpt-5.6-terra"

# Owner-only evaluation tracing. When either required value is absent,
# Braintrust export is disabled. Temporary demo operations are never traced.
BRAINTRUST_API_KEY="replace-with-braintrust-api-key"
BRAINTRUST_PROJECT="ThoughtForm"
BRAINTRUST_ENVIRONMENT="development"
